router.get('/api/check-reminders', (req, res) => {
  const { userId } = req.query;

  if (!userId) {
    return res.status(400).json({ error: 'userId is required' });
  }

  const query = `
    SELECT id, leadid, notes, reminder_setting
    FROM travel_opportunity
    WHERE reminder_setting IS NOT NULL
      AND User_id = ?
  `;

  db.query(query, [userId], (error, results) => {
    if (error) {
      console.error('SQL Error:', error.message);
      return res.status(500).json({ error: 'Database error' });
    }

    const now = new Date();
    const activeReminders = [];

    results.forEach(item => {
      const reminderTime = new Date(item.reminder_setting);
      if (isNaN(reminderTime.getTime())) return;

      const diffSeconds = Math.floor((reminderTime - now) / 1000);

      // Only future reminders
      if (diffSeconds <= 0) return;

      // ⏱️ Window function (±30 sec tolerance)
      const isInWindow = (minutes) => {
        const target = minutes * 60;
        return diffSeconds >= target - 30 && diffSeconds <= target + 30;
      };

      let label = null;

      if (isInWindow(60)) {
        label = "1 Hour";
      } else if (isInWindow(30)) {
        label = "30 Min";
      } else if (isInWindow(15)) {
        label = "15 Min";
      }

      if (label) {
        activeReminders.push({
          id: item.id,
          leadid: item.leadid,
          notes: item.notes,
          label,
          reminder_time: item.reminder_setting
        });
      }
    });

    res.json(activeReminders);
  });
});
module.exports = router;
