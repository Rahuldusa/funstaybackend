router.get("/api/fetch-lead-suppliers", (req, res) => {
  // First query to get lead and travel opportunity data
  const leadQuery = `
      SELECT 
    a.*, 
    MAX(t.destination) AS travel_destination, 
    MAX(t.quotation_id) AS quotation_id, 
    MAX(t.created_at) AS travel_created_at, 
    MAX(t.origincity) AS travel_origincity, 
    MAX(t.start_date) AS start_date, 
    MAX(t.end_date) AS end_date, 
    MAX(t.duration) AS duration, 
    MAX(t.adults_count) AS adults_count, 
    MAX(t.children_count) AS children_count, 
    MAX(t.child_ages) AS child_ages, 
    MAX(t.approx_budget) AS approx_budget, 
    MAX(t.description) AS travel_description, 
    MAX(t.email_sent) AS email_sent,
    -- Fetching the most recent updated_at for each leadid from different tables
    GREATEST(
        IFNULL(MAX(a.updated_at), '1970-01-01'),
        IFNULL(MAX(t.updated_at), '1970-01-01'),
        IFNULL(MAX(p.updatedAt), '1970-01-01'),
        IFNULL(MAX(r.updated_at), '1970-01-01')
    ) AS most_recent_updated_at
FROM addleads a 
LEFT JOIN travel_opportunity t ON a.leadid = t.leadid
LEFT JOIN payment_log p ON a.leadid = p.leadid
LEFT JOIN receivables r ON a.leadid = r.leadid
WHERE a.archive IS NULL
AND a.status = 'opportunity'
GROUP BY a.leadid
ORDER BY t.leadid DESC`;

  db.query(leadQuery, (err, leadResults) => {
    if (err) {
      console.error("Error fetching lead data: ", err);
      return res.status(500).json({ error: "Database query failed" });
    }

    if (leadResults.length === 0) {
      return res.status(404).json({ message: "No lead data found" });
    }

    // Extract leadids from the results
    const leadIds = leadResults.map(lead => lead.leadid);

    if (leadIds.length === 0) {
      return res.json(leadResults.map(lead => ({
        ...lead,
        suppliers: [],
        payment_logs: []
      })));
    }

    // Query to get suppliers for these leadids
    const supplierQuery = `
        SELECT * FROM suppliers 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, id DESC`;

    // Query to get payment logs for these leadids
    const paymentLogQuery = `
        SELECT * FROM payment_log 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, paid_on DESC`;

    // Execute both queries in parallel using Promise.all
    Promise.all([
      new Promise((resolve, reject) => {
        db.query(supplierQuery, [leadIds], (supplierErr, supplierResults) => {
          if (supplierErr) {
            reject("Error fetching supplier data: " + supplierErr);
          } else {
            resolve(supplierResults);
          }
        });
      }),
      new Promise((resolve, reject) => {
        db.query(paymentLogQuery, [leadIds], (paymentErr, paymentResults) => {
          if (paymentErr) {
            reject("Error fetching payment log data: " + paymentErr);
          } else {
            resolve(paymentResults);
          }
        });
      })
    ])
    .then(([supplierResults, paymentResults]) => {
      // Group suppliers by leadid
      const suppliersByLead = supplierResults.reduce((acc, supplier) => {
        if (!acc[supplier.leadid]) {
          acc[supplier.leadid] = [];
        }
        acc[supplier.leadid].push(supplier);
        return acc;
      }, {});

      // Group payment logs by leadid
      const paymentsByLead = paymentResults.reduce((acc, payment) => {
        if (!acc[payment.leadid]) {
          acc[payment.leadid] = [];
        }
        acc[payment.leadid].push(payment);
        return acc;
      }, {});

      // Combine all data
      const combinedResults = leadResults.map(lead => ({
        ...lead,
        suppliers: suppliersByLead[lead.leadid] || [],
        payment_logs: paymentsByLead[lead.leadid] || []
      }));

      res.json(combinedResults);
    })
    .catch((error) => {
      console.error(error);
      res.status(500).json({ error: "Error fetching suppliers or payment logs" });
    });
  });
});


router.get("/api/fetch-lead-suppliers-report", (req, res) => {
  // First query to get lead and travel opportunity data
  const leadQuery = `
      SELECT 
    a.*, 
    MAX(t.destination) AS travel_destination, 
    MAX(t.quotation_id) AS quotation_id, 
    MAX(t.created_at) AS travel_created_at, 
    MAX(t.origincity) AS travel_origincity, 
    MAX(t.start_date) AS start_date, 
    MAX(t.end_date) AS end_date, 
    MAX(t.duration) AS duration, 
    MAX(t.adults_count) AS adults_count, 
    MAX(t.children_count) AS children_count, 
    MAX(t.child_ages) AS child_ages, 
    MAX(t.approx_budget) AS approx_budget, 
    MAX(t.description) AS travel_description, 
    MAX(t.email_sent) AS email_sent,
    -- Fetching the most recent updated_at for each leadid from different tables
    GREATEST(
        IFNULL(MAX(a.updated_at), '1970-01-01'),
        IFNULL(MAX(t.updated_at), '1970-01-01'),
        IFNULL(MAX(p.updatedAt), '1970-01-01'),
        IFNULL(MAX(r.updated_at), '1970-01-01')
    ) AS most_recent_updated_at,
    -- Get tag_names from customers table (using subquery to avoid join interference)
    (
        SELECT GROUP_CONCAT(tg.label ORDER BY tg.id SEPARATOR ',')
        FROM customers c
        LEFT JOIN tags tg ON 
            FIND_IN_SET(
                tg.id, 
                REPLACE(REPLACE(REPLACE(c.tags, '[', ''), ']', ''), ' ', '')
            ) > 0
        WHERE c.id = a.customerid
        GROUP BY c.id
    ) AS tag_names
FROM addleads a 
LEFT JOIN travel_opportunity t ON a.leadid = t.leadid
LEFT JOIN payment_log p ON a.leadid = p.leadid
LEFT JOIN receivables r ON a.leadid = r.leadid
WHERE a.archive IS NULL
AND a.status = 'opportunity'
GROUP BY a.leadid
ORDER BY t.leadid DESC`;

  db.query(leadQuery, (err, leadResults) => {
    if (err) {
      console.error("Error fetching lead data: ", err);
      return res.status(500).json({ error: "Database query failed" });
    }

    if (leadResults.length === 0) {
      return res.status(404).json({ message: "No lead data found" });
    }

    // Convert tag_names from comma-separated string to array for each lead
    const leadResultsWithTagsArray = leadResults.map(lead => ({
      ...lead,
      tag_names: lead.tag_names ? lead.tag_names.split(',') : []
    }));

    // Extract leadids from the results
    const leadIds = leadResults.map(lead => lead.leadid);

    if (leadIds.length === 0) {
      return res.json(leadResultsWithTagsArray.map(lead => ({
        ...lead,
        suppliers: [],
        payment_logs: []
      })));
    }

    // Query to get suppliers for these leadids
    const supplierQuery = `
        SELECT * FROM suppliers 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, id DESC`;

    // Query to get payment logs for these leadids
    const paymentLogQuery = `
        SELECT * FROM payment_log 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, paid_on DESC`;

    // Execute both queries in parallel using Promise.all
    Promise.all([
      new Promise((resolve, reject) => {
        db.query(supplierQuery, [leadIds], (supplierErr, supplierResults) => {
          if (supplierErr) {
            reject("Error fetching supplier data: " + supplierErr);
          } else {
            resolve(supplierResults);
          }
        });
      }),
      new Promise((resolve, reject) => {
        db.query(paymentLogQuery, [leadIds], (paymentErr, paymentResults) => {
          if (paymentErr) {
            reject("Error fetching payment log data: " + paymentErr);
          } else {
            resolve(paymentResults);
          }
        });
      })
    ])
    .then(([supplierResults, paymentResults]) => {
      // Group suppliers by leadid
      const suppliersByLead = supplierResults.reduce((acc, supplier) => {
        if (!acc[supplier.leadid]) {
          acc[supplier.leadid] = [];
        }
        acc[supplier.leadid].push(supplier);
        return acc;
      }, {});

      // Group payment logs by leadid
      const paymentsByLead = paymentResults.reduce((acc, payment) => {
        if (!acc[payment.leadid]) {
          acc[payment.leadid] = [];
        }
        acc[payment.leadid].push(payment);
        return acc;
      }, {});

      // Combine all data
      const combinedResults = leadResultsWithTagsArray.map(lead => ({
        ...lead,
        suppliers: suppliersByLead[lead.leadid] || [],
        payment_logs: paymentsByLead[lead.leadid] || []
      }));

      res.json(combinedResults);
    })
    .catch((error) => {
      console.error(error);
      res.status(500).json({ error: "Error fetching suppliers or payment logs" });
    });
  });
});

router.get("/api/fetch-lead-suppliers-manager-report/:managerid", (req, res) => {
  const managerId = req.params.managerid;
  
  // First query to get lead and travel opportunity data filtered by managerid
  const leadQuery = `
    SELECT 
      a.*, 
      MAX(t.destination) AS travel_destination, 
      MAX(t.quotation_id) AS quotation_id, 
      MAX(t.created_at) AS travel_created_at, 
      MAX(t.origincity) AS travel_origincity, 
      MAX(t.start_date) AS start_date, 
      MAX(t.end_date) AS end_date, 
      MAX(t.duration) AS duration, 
      MAX(t.adults_count) AS adults_count, 
      MAX(t.children_count) AS children_count, 
      MAX(t.child_ages) AS child_ages, 
      MAX(t.approx_budget) AS approx_budget, 
      MAX(t.description) AS travel_description, 
      MAX(t.email_sent) AS email_sent,
      -- Fetching the most recent updated_at for each leadid from different tables
      GREATEST(
          IFNULL(MAX(a.updated_at), '1970-01-01'),
          IFNULL(MAX(t.updated_at), '1970-01-01'),
          IFNULL(MAX(p.updatedAt), '1970-01-01'),
          IFNULL(MAX(r.updated_at), '1970-01-01')
      ) AS most_recent_updated_at,
      -- Get tag_names from customers table
      (
          SELECT GROUP_CONCAT(tg.label ORDER BY tg.id SEPARATOR ',')
          FROM customers c
          LEFT JOIN tags tg ON 
              FIND_IN_SET(
                  tg.id, 
                  REPLACE(REPLACE(REPLACE(c.tags, '[', ''), ']', ''), ' ', '')
              ) > 0
          WHERE c.id = a.customerid
          GROUP BY c.id
      ) AS tag_names
    FROM addleads a 
    LEFT JOIN travel_opportunity t ON a.leadid = t.leadid
    LEFT JOIN payment_log p ON a.leadid = p.leadid
    LEFT JOIN receivables r ON a.leadid = r.leadid
    WHERE a.archive IS NULL
      AND a.status = 'opportunity'
      AND a.managerid = ?
    GROUP BY a.leadid
    ORDER BY t.leadid DESC`;

  db.query(leadQuery, [managerId], (err, leadResults) => {
    if (err) {
      console.error("Error fetching lead data: ", err);
      return res.status(500).json({ error: "Database query failed" });
    }

    if (leadResults.length === 0) {
      return res.json([]); // Return empty array instead of 404
    }

    // Convert tag_names from comma-separated string to array for each lead
    const leadResultsWithTagsArray = leadResults.map(lead => ({
      ...lead,
      tag_names: lead.tag_names ? lead.tag_names.split(',') : []
    }));

    // Extract leadids from the results
    const leadIds = leadResults.map(lead => lead.leadid);

    if (leadIds.length === 0) {
      return res.json(leadResultsWithTagsArray.map(lead => ({
        ...lead,
        suppliers: [],
        payment_logs: [],
        receivables: []
      })));
    }

    // Query to get suppliers for these leadids
    const supplierQuery = `
        SELECT * FROM suppliers 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, id DESC`;

    // Query to get payment logs for these leadids
    const paymentLogQuery = `
        SELECT * FROM payment_log 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, paid_on DESC`;

    // Query to get receivables for these leadids
    const receivablesQuery = `
        SELECT * FROM receivables 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, paid_on DESC`;

    // Execute all queries in parallel using Promise.all
    Promise.all([
      new Promise((resolve, reject) => {
        db.query(supplierQuery, [leadIds], (supplierErr, supplierResults) => {
          if (supplierErr) {
            reject("Error fetching supplier data: " + supplierErr);
          } else {
            resolve(supplierResults);
          }
        });
      }),
      new Promise((resolve, reject) => {
        db.query(paymentLogQuery, [leadIds], (paymentErr, paymentResults) => {
          if (paymentErr) {
            reject("Error fetching payment log data: " + paymentErr);
          } else {
            resolve(paymentResults);
          }
        });
      }),
      new Promise((resolve, reject) => {
        db.query(receivablesQuery, [leadIds], (receivablesErr, receivablesResults) => {
          if (receivablesErr) {
            reject("Error fetching receivables data: " + receivablesErr);
          } else {
            resolve(receivablesResults);
          }
        });
      })
    ])
    .then(([supplierResults, paymentResults, receivablesResults]) => {
      // Group suppliers by leadid
      const suppliersByLead = supplierResults.reduce((acc, supplier) => {
        if (!acc[supplier.leadid]) {
          acc[supplier.leadid] = [];
        }
        acc[supplier.leadid].push(supplier);
        return acc;
      }, {});

      // Group payment logs by leadid
      const paymentsByLead = paymentResults.reduce((acc, payment) => {
        if (!acc[payment.leadid]) {
          acc[payment.leadid] = [];
        }
        acc[payment.leadid].push(payment);
        return acc;
      }, {});

      // Group receivables by leadid
      const receivablesByLead = receivablesResults.reduce((acc, receivable) => {
        if (!acc[receivable.leadid]) {
          acc[receivable.leadid] = [];
        }
        acc[receivable.leadid].push(receivable);
        return acc;
      }, {});

      // Combine all data
      const combinedResults = leadResultsWithTagsArray.map(lead => ({
        ...lead,
        suppliers: suppliersByLead[lead.leadid] || [],
        payment_logs: paymentsByLead[lead.leadid] || [],
        receivables: receivablesByLead[lead.leadid] || []
      }));

      res.json(combinedResults);
    })
    .catch((error) => {
      console.error(error);
      res.status(500).json({ error: "Error fetching suppliers or payment logs" });
    });
  });
});
router.get("/api/fetch-lead-suppliers-employee-report/:userId", (req, res) => {
  // Get userId (employee ID) from URL parameters
  const userId = req.params.userId;
  
  // Base query condition
  let userCondition = '';
  let queryParams = [];
  
  if (userId) {
    userCondition = 'AND a.assignedSalesId = ?';
    queryParams.push(userId);
  }

  // First query to get lead and travel opportunity data
  const leadQuery = `
      SELECT 
    a.*, 
    MAX(t.destination) AS travel_destination, 
    MAX(t.quotation_id) AS quotation_id, 
    MAX(t.created_at) AS travel_created_at, 
    MAX(t.origincity) AS travel_origincity, 
    MAX(t.start_date) AS start_date, 
    MAX(t.end_date) AS end_date, 
    MAX(t.duration) AS duration, 
    MAX(t.adults_count) AS adults_count, 
    MAX(t.children_count) AS children_count, 
    MAX(t.child_ages) AS child_ages, 
    MAX(t.approx_budget) AS approx_budget, 
    MAX(t.description) AS travel_description, 
    MAX(t.email_sent) AS email_sent,
    -- Fetching the most recent updated_at for each leadid from different tables
    GREATEST(
        IFNULL(MAX(a.updated_at), '1970-01-01'),
        IFNULL(MAX(t.updated_at), '1970-01-01'),
        IFNULL(MAX(p.updatedAt), '1970-01-01'),
        IFNULL(MAX(r.updated_at), '1970-01-01')
    ) AS most_recent_updated_at
FROM addleads a 
LEFT JOIN travel_opportunity t ON a.leadid = t.leadid
LEFT JOIN payment_log p ON a.leadid = p.leadid
LEFT JOIN receivables r ON a.leadid = r.leadid
WHERE a.archive IS NULL
AND a.status = 'opportunity'
${userCondition}
GROUP BY a.leadid
ORDER BY t.leadid DESC`;

  db.query(leadQuery, queryParams, (err, leadResults) => {
    if (err) {
      console.error("Error fetching lead data: ", err);
      return res.status(500).json({ error: "Database query failed" });
    }

    if (leadResults.length === 0) {
      return res.status(404).json({ message: "No lead data found" });
    }

    // Extract leadids from the results
    const leadIds = leadResults.map(lead => lead.leadid);

    if (leadIds.length === 0) {
      return res.json(leadResults.map(lead => ({
        ...lead,
        suppliers: [],
        payment_logs: []
      })));
    }

    // Query to get suppliers for these leadids
    const supplierQuery = `
        SELECT * FROM suppliers 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, id DESC`;

    // Query to get payment logs for these leadids
    const paymentLogQuery = `
        SELECT * FROM payment_log 
        WHERE leadid IN (?) 
        ORDER BY leadid DESC, paid_on DESC`;

    // Execute both queries in parallel using Promise.all
    Promise.all([
      new Promise((resolve, reject) => {
        db.query(supplierQuery, [leadIds], (supplierErr, supplierResults) => {
          if (supplierErr) {
            reject("Error fetching supplier data: " + supplierErr);
          } else {
            resolve(supplierResults);
          }
        });
      }),
      new Promise((resolve, reject) => {
        db.query(paymentLogQuery, [leadIds], (paymentErr, paymentResults) => {
          if (paymentErr) {
            reject("Error fetching payment log data: " + paymentErr);
          } else {
            resolve(paymentResults);
          }
        });
      })
    ])
    .then(([supplierResults, paymentResults]) => {
      // Group suppliers by leadid
      const suppliersByLead = supplierResults.reduce((acc, supplier) => {
        if (!acc[supplier.leadid]) {
          acc[supplier.leadid] = [];
        }
        acc[supplier.leadid].push(supplier);
        return acc;
      }, {});

      // Group payment logs by leadid
      const paymentsByLead = paymentResults.reduce((acc, payment) => {
        if (!acc[payment.leadid]) {
          acc[payment.leadid] = [];
        }
        acc[payment.leadid].push(payment);
        return acc;
      }, {});

      // Combine all data
      const combinedResults = leadResults.map(lead => ({
        ...lead,
        suppliers: suppliersByLead[lead.leadid] || [],
        payment_logs: paymentsByLead[lead.leadid] || []
      }));

      res.json(combinedResults);
    })
    .catch((error) => {
      console.error(error);
      res.status(500).json({ error: "Error fetching suppliers or payment logs" });
    });
  });
});



router.get('/comments-report/:leadid', (req, res) => {
  const { leadid } = req.params;

  const query = `
    SELECT 
      id,
      leadid,
      timestamp,
      text,
      name
    FROM comments
    WHERE leadid = ?
    ORDER BY timestamp DESC
  `;

  db.query(query, [leadid], (err, results) => {
    if (err) {
      console.error("DB Fetch Error:", err);
      return res.status(500).json({
        success: false,
        message: "Failed to fetch comments"
      });
    }

    res.status(200).json(results);
  });
});

router.post('/comments/bulk-counts', (req, res) => {
  const { leadIds } = req.body;

  if (!leadIds || leadIds.length === 0) {
    return res.status(200).json({ counts: {}, dates: {}, comments: {} });
  }

  const placeholders = leadIds.map(() => '?').join(',');
  const query = `
    SELECT leadid, id, timestamp, text
    FROM comments
    WHERE leadid IN (${placeholders})
  `;

  db.query(query, leadIds, (err, results) => {
    if (err) {
      console.error("DB Bulk Comment Error:", err);
      return res.status(500).json({ success: false, message: "Failed to fetch bulk comments" });
    }

    const counts = {};
    const dates = {};
    const comments = {};

    leadIds.forEach(id => {
      counts[id] = 0;
      dates[id] = [];
      comments[id] = [];
    });

    results.forEach(row => {
      counts[row.leadid] = (counts[row.leadid] || 0) + 1;

      if (!dates[row.leadid]) dates[row.leadid] = [];
      dates[row.leadid].push(row.timestamp);

      if (!comments[row.leadid]) comments[row.leadid] = [];
      comments[row.leadid].push({
        date: row.timestamp,
        text: row.text
      });
    });

    res.status(200).json({ counts, dates, comments });
  });
});
